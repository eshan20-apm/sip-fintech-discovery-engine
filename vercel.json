{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.py?path=/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?path=/$1"
    }
  ]
}
